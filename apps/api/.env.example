# انسخ هذا الملف إلى .env
NODE_ENV=development
PORT=4000
# مطلوب في الإنتاج: نص عشوائي طويل
JWT_SECRET=
# كلمة مرور حساب المدير عند أول تشغيل في الإنتاج (وإلا تُولَّد وتُطبع في السجل)
ADMIN_PASSWORD=
# تسجيل الدخول عبر Google (Firebase Authentication). القيم الافتراضية لمشروع المنصة مضمّنة في config.js وهي علنية.
# لإلغاء الخدمة كلياً اترك السطر FIREBASE_API_KEY= فارغاً بعد إزالة علامة #. يمكن أيضاً تعطيلها من إعدادات المدير.
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
# أصول الواجهة المسموح لها (مفصولة بفاصلة)، مثال: https://dxxxx.cloudfront.net
CORS_ORIGINS=
# SERVE_WEB=false لتعطيل تقديم الواجهة من نفس الخادم
SERVE_WEB=true
# خلف proxy / load balancer
TRUST_PROXY=false
# ترجمة محتوى المستخدمين (المنشورات...) إلى لغة الواجهة: google (افتراضي) | mymemory | none لتعطيلها.
# تنبيه: المزوّد الافتراضي نقطة Google المجانية غير الرسمية؛ يُرسَل إليها نص المنشورات العامة للترجمة فقط.
# للإنتاج الجاد استبدلها بمزوّد رسمي بمفتاح عبر setProvider في apps/api/src/translate.js
TRANSLATE_PROVIDER=google
# رابط اتصال PostgreSQL للإنتاج (مثل Neon): postgresql://user:pass@host/db?sslmode=require
# بدونه تُستخدم PGlite محلياً (PostgreSQL داخل العملية) وتُفقد البيانات على الخدمات ذات القرص المؤقت.
DATABASE_URL=
# مسار أساس لملفات PGlite المحلية (افتراضي data/awtad.db)
DB_FILE=

# عنوان المنصة العلني (لروابط البريد ولعنوان عودة LinkedIn). على Render يؤخذ تلقائياً من RENDER_EXTERNAL_URL.
APP_URL=
# تسجيل الدخول عبر LinkedIn (Sign In with LinkedIn using OpenID Connect). عنوان العودة المسجّل في التطبيق:
#   {APP_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# استرجاع كلمة المرور بالبريد. الطريقة 1 (الأسهل، مجانية بلا دومين): Gmail عبر Google Apps Script، انظر tools/gmail-relay.gs
MAIL_SCRIPT_URL=
MAIL_SCRIPT_SECRET=
# الطريقة 2: Brevo (مجاني 300 رسالة يومياً). المرسِل يجب أن يكون موثّقاً في Brevo.
# ملاحظة: SMTP محجوب على الخطط المجانية في Render، لذلك نستخدم واجهة HTTPS.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=أوتاد

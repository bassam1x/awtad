# انسخ هذا الملف إلى .env
NODE_ENV=development
PORT=4000
# مطلوب في الإنتاج: نص عشوائي طويل
JWT_SECRET=
# كلمة مرور حساب المدير عند أول تشغيل في الإنتاج (وإلا تُولَّد وتُطبع في السجل)
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
# أصول الواجهة المسموح لها (مفصولة بفاصلة)، مثال: https://dxxxx.cloudfront.net
CORS_ORIGINS=
# SERVE_WEB=false لتعطيل تقديم الواجهة من نفس الخادم
SERVE_WEB=true
# خلف proxy / load balancer
TRUST_PROXY=false
# ترجمة محتوى المستخدمين (المنشورات...) إلى لغة الواجهة: google (افتراضي) | mymemory | none لتعطيلها.
# تنبيه: المزوّد الافتراضي نقطة Google المجانية غير الرسمية؛ يُرسَل إليها نص المنشورات العامة للترجمة فقط.
# للإنتاج الجاد استبدلها بمزوّد رسمي بمفتاح عبر setProvider في apps/api/src/translate.js
TRANSLATE_PROVIDER=google
# مسار قاعدة SQLite (افتراضي data/awtad.db)
DB_FILE=

# حفظ القاعدة خارج الخادم (مهم على الخدمات المجانية التي تمسح قرصها عند إعادة التشغيل).
# تؤخذ لقطة مضغوطة ومشفّرة (AES-256-GCM) بعد كل تعديل، وتُستعاد عند الإقلاع.
# مفتاح التشفير؛ احفظه جيداً: بدونه لا تُفكّ النسخة (افتراضياً JWT_SECRET)
BACKUP_SECRET=
# مستودع GitHub خاص يُخزَّن فيه ملف اللقطة كملحق إصدار، مثل: owner/awtad-data
BACKUP_GITHUB_REPO=
# توكن بصلاحية Contents: Read and write على ذلك المستودع فقط
BACKUP_GITHUB_TOKEN=
# بديل: مجلد على قرص دائم (يتجاوز GitHub)
BACKUP_DIR=
